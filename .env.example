# Supabase — proyecto oc-elevate (hhjzsexyxvakptovsdwu)
# URL y anon key son públicas por diseño (van al bundle del cliente); el
# service role key NUNCA se expone al cliente (ver lib/supabase/admin.ts).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sitio (usado para construir la URL de retorno del magic link)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Conexión directa a Postgres (pooler, modo transacción — puerto 6543) para
# scripts o funciones serverless que necesiten SQL directo en vez de
# PostgREST. No hace falta para el uso normal de la app.
SUPABASE_DB_URL=
